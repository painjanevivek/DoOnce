# Public API base URL used by the dashboard. Production builds require HTTPS.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# Optional official Chrome Web Store detail URL. Production values must use
# https://chromewebstore.google.com/detail/<extension-name>/<extension-id>.
NEXT_PUBLIC_EXTENSION_INSTALL_URL=

# Extension API origin. Release bundles require HTTPS.
DOONCE_EXTENSION_API_BASE_URL=http://127.0.0.1:4000

# Exact authorized HTTPS origin for the one pilot report workflow.
DOONCE_EXTENSION_PILOT_ALLOWED_ORIGIN=

# Must exactly match extension/manifest.json for release packaging.
DOONCE_EXTENSION_VERSION=0.4.0
